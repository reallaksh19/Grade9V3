{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/reallaksh19/Grade9V3/Shared/gates/gate.schema.json",
  "title": "Technical engineering gate registry",
  "description": "Upstream technical authority for one subject: what the subject matter itself requires before any teaching is authored. Subject-neutral by construction -- what counts as a valid symbol, representation or check is declared by the subject contract, not fixed here. Adapted from the 16-point gate contract in reallaksh19/Common PR #383, generalised across subjects.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_id",
    "subject",
    "maturity",
    "gates"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "registry_id": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "maturity": {
      "const": "ENGINEERING",
      "description": "Frozen. A gate specifies what the subject requires; it never carries a psychometric or learner-outcome claim."
    },
    "provenance": {
      "type": "object"
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/gate"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9-]*[A-Z0-9]$",
      "minLength": 2
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate_id",
        "title",
        "curriculum",
        "tier",
        "scope_state",
        "canonical_concepts",
        "prerequisites",
        "relations",
        "representations",
        "validity_conditions",
        "reasoning_sequence",
        "misconceptions",
        "problem_families",
        "difficulty",
        "badges",
        "falsification_cases"
      ],
      "properties": {
        "gate_id": {
          "$ref": "#/$defs/identifier"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "curriculum": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "board",
            "grade",
            "chapter",
            "scope_class"
          ],
          "properties": {
            "board": {
              "$ref": "#/$defs/text"
            },
            "grade": {
              "type": "integer",
              "minimum": 9,
              "maximum": 11
            },
            "chapter": {
              "$ref": "#/$defs/text"
            },
            "section": {
              "$ref": "#/$defs/text"
            },
            "scope_class": {
              "enum": [
                "PRESCRIBED",
                "OWNER_EXTENSION"
              ],
              "description": "PRESCRIBED asserts the board actually prescribes this; it requires an exact binding in the subject's curriculum binding registry or the gate is held."
            }
          }
        },
        "tier": {
          "enum": [
            "NOT_IN_JEE",
            "JEE_MAINS",
            "JEE_ADVANCED",
            "BOTH"
          ]
        },
        "scope_state": {
          "enum": [
            "ACTIVE",
            "HELD"
          ]
        },
        "held_reason": {
          "$ref": "#/$defs/text"
        },
        "canonical_concepts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "concept_id",
              "statement"
            ],
            "properties": {
              "concept_id": {
                "$ref": "#/$defs/identifier"
              },
              "statement": {
                "$ref": "#/$defs/text"
              }
            }
          }
        },
        "prerequisites": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "external_prerequisites": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "capability_id",
              "provider_subject",
              "acceptance_status"
            ],
            "properties": {
              "capability_id": {
                "$ref": "#/$defs/identifier"
              },
              "provider_subject": {
                "$ref": "#/$defs/text"
              },
              "statement": {
                "$ref": "#/$defs/text"
              },
              "acceptance_status": {
                "enum": [
                  "PROVIDER_REVIEW_REQUIRED",
                  "PROVIDER_ACCEPTED"
                ],
                "description": "A subject may never mark another subject's capability accepted on its own authority."
              }
            }
          }
        },
        "relations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "relation_id",
              "expression",
              "meaning",
              "symbols",
              "conditions"
            ],
            "properties": {
              "relation_id": {
                "$ref": "#/$defs/identifier"
              },
              "expression": {
                "$ref": "#/$defs/text"
              },
              "meaning": {
                "$ref": "#/$defs/text"
              },
              "symbols": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "description": "Required keys are declared per subject in the contract's required_symbol_fields; the validator enforces them.",
                  "required": [
                    "symbol",
                    "meaning"
                  ],
                  "properties": {
                    "symbol": {
                      "$ref": "#/$defs/text"
                    },
                    "meaning": {
                      "$ref": "#/$defs/text"
                    }
                  }
                }
              },
              "conditions": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/text"
                }
              },
              "validator_refs": {
                "type": "array",
                "uniqueItems": true,
                "description": "Subject validator catalogue entries that can recompute numerical instances of this relation. Omit when the relation has no implemented machine validator.",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Z0-9_]*$",
                  "minLength": 2
                }
              }
            }
          }
        },
        "representations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "representation_id",
              "kind",
              "required_labels",
              "verification_method",
              "must_not_imply"
            ],
            "properties": {
              "representation_id": {
                "$ref": "#/$defs/identifier"
              },
              "kind": {
                "$ref": "#/$defs/text"
              },
              "required_labels": {
                "type": "array",
                "minItems": 1,
                "description": "What the depiction must carry, and which of the subject contract's requirements for this kind each label satisfies. The correspondence is declared rather than inferred: comparing a label's prose to a requirement's prose is a string heuristic across two different layers of authoring, and it would be wrong as often as it was right.",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "label",
                    "satisfies"
                  ],
                  "properties": {
                    "label": {
                      "$ref": "#/$defs/text"
                    },
                    "satisfies": {
                      "type": "array",
                      "minItems": 0,
                      "description": "Requirement ids from the subject contract's representation_kinds[].requires for this kind. Empty is legal: a label may carry something this gate needs that the kind does not demand of every figure.",
                      "items": {
                        "$ref": "#/$defs/text"
                      }
                    }
                  }
                }
              },
              "verification_method": {
                "$ref": "#/$defs/text"
              },
              "must_not_imply": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/text"
                }
              },
              "relation_bindings": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/identifier"
                }
              },
              "concept_bindings": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/identifier"
                }
              }
            }
          }
        },
        "validity_conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "reasoning_sequence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "step_id",
              "sequence",
              "action",
              "why_valid"
            ],
            "properties": {
              "step_id": {
                "$ref": "#/$defs/identifier"
              },
              "sequence": {
                "type": "integer",
                "minimum": 1
              },
              "action": {
                "$ref": "#/$defs/text"
              },
              "why_valid": {
                "$ref": "#/$defs/text"
              },
              "depends_on": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/identifier"
                }
              }
            }
          }
        },
        "transformations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "transformation_id",
              "statement"
            ],
            "properties": {
              "transformation_id": {
                "$ref": "#/$defs/identifier"
              },
              "statement": {
                "$ref": "#/$defs/text"
              }
            }
          }
        },
        "misconceptions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "misconception_id",
              "wrong_idea",
              "counterexample",
              "repair"
            ],
            "properties": {
              "misconception_id": {
                "$ref": "#/$defs/identifier"
              },
              "wrong_idea": {
                "$ref": "#/$defs/text"
              },
              "counterexample": {
                "$ref": "#/$defs/text"
              },
              "repair": {
                "$ref": "#/$defs/text"
              }
            }
          }
        },
        "problem_families": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "family_id",
              "title"
            ],
            "properties": {
              "family_id": {
                "$ref": "#/$defs/identifier"
              },
              "title": {
                "$ref": "#/$defs/text"
              },
              "hidden_invariants": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/text"
                }
              },
              "required_representation": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/identifier"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        },
        "difficulty": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maturity",
            "analytical_steps",
            "prerequisite_depth"
          ],
          "properties": {
            "maturity": {
              "const": "ENGINEERING"
            },
            "analytical_steps": {
              "type": "integer",
              "minimum": 1
            },
            "prerequisite_depth": {
              "type": "integer",
              "minimum": 0
            },
            "note": {
              "$ref": "#/$defs/text"
            }
          }
        },
        "badges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "falsification_cases": {
          "type": "array",
          "minItems": 1,
          "description": "Mutations that must break this gate. Every case_id must be bound to a mutation that is actually applied, and the outcome it declares must be the outcome observed -- a declared falsifier nothing runs is a claim about checkability that was never checked.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "case_id",
              "mutation"
            ],
            "oneOf": [
              {
                "required": [
                  "expected_violation"
                ]
              },
              {
                "required": [
                  "expected_report"
                ]
              }
            ],
            "properties": {
              "case_id": {
                "$ref": "#/$defs/identifier"
              },
              "mutation": {
                "$ref": "#/$defs/text"
              },
              "expected_violation": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]*$",
                "description": "The violation code the validator must raise. A code, not a sentence: one case declared 'HELD_INSUFFICIENT_AUTHORITY in the curriculum report', which no comparison could ever satisfy."
              },
              "expected_report": {
                "type": "string",
                "minLength": 1,
                "description": "For a mutation whose outcome is a report state rather than a raise: the curriculum-report key that must become non-empty."
              }
            }
          }
        }
      }
    }
  }
}
