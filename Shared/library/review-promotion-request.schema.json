{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://grade9v3.local/review-promotion-request.schema.json",
  "title":"Review promotion request",
  "type":"object",
  "additionalProperties":false,
  "required":[
    "promotion_id","version","subject","target_package","record_id","record_digest",
    "target_stage","evidence","authoring_run_receipt","prior_promotion_receipt"
  ],
  "properties":{
    "promotion_id":{"type":"string","minLength":1},
    "version":{"const":"1.0.0"},
    "subject":{"type":"string","minLength":1},
    "target_package":{"type":"string","minLength":1},
    "record_id":{"type":"string","minLength":1},
    "record_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "target_stage":{"enum":["REVIEWED","CURATED"]},
    "evidence":{
      "oneOf":[
        {
          "type":"object",
          "additionalProperties":false,
          "required":[
            "kind","reviewer_id","reviewed_on","scope","originals_inspected",
            "result","observation","independence"
          ],
          "properties":{
            "kind":{"const":"INDEPENDENT_REVIEW"},
            "reviewer_id":{"type":"string","minLength":1},
            "reviewed_on":{"type":"string","minLength":1},
            "scope":{"type":"string","minLength":1},
            "originals_inspected":{"const":true},
            "result":{"const":"PASS"},
            "observation":{"type":"string","minLength":1},
            "independence":{"type":"string","minLength":1}
          }
        },
        {
          "type":"object",
          "additionalProperties":false,
          "required":[
            "kind","accepted_by","accepted_on","scope","result","observation"
          ],
          "properties":{
            "kind":{"const":"CURATION_ACCEPTANCE"},
            "accepted_by":{"type":"string","minLength":1},
            "accepted_on":{"type":"string","minLength":1},
            "scope":{"type":"string","minLength":1},
            "result":{"const":"PASS"},
            "observation":{"type":"string","minLength":1}
          }
        }
      ]
    },
    "authoring_run_receipt":{
      "anyOf":[
        {
          "type":"object","additionalProperties":false,
          "required":["path","digest"],
          "properties":{
            "path":{"type":"string","minLength":1},
            "digest":{"type":"string","pattern":"^[0-9a-f]{64}$"}
          }
        },
        {"type":"null"}
      ]
    },
    "prior_promotion_receipt":{
      "anyOf":[
        {
          "type":"object","additionalProperties":false,
          "required":["path","digest"],
          "properties":{
            "path":{"type":"string","minLength":1},
            "digest":{"type":"string","pattern":"^[0-9a-f]{64}$"}
          }
        },
        {"type":"null"}
      ]
    }
  }
}
