{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grade9v3.local/authoring-request.schema.json",
  "title": "Third-agent authoring request",
  "description": "Plan-level request. Missing owner decisions are legal and are returned as REQUIRED_OWNER_INPUTS; execution remains fail-closed.",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "subject", "requested_cores"],
  "anyOf": [{"required": ["subtopic"]}, {"required": ["bucket_id"]}],
  "properties": {
    "request_id": {"type": "string", "minLength": 1},
    "subject": {"type": "string", "minLength": 1},
    "subtopic": {"type": "string", "minLength": 1},
    "bucket_id": {"type": "string", "minLength": 1},
    "requested_cores": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"enum": ["CORE1", "CORE2", "CORE1A", "CORE1B", "CORE2A", "CORE2B"]}
    },
    "source_basis": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "source_inspection": {
      "type": "object", "additionalProperties": false, "required": ["status"],
      "properties": {
        "status": {"enum": ["UNINSPECTED", "INGESTED_SUFFICIENT", "INGESTED_INSUFFICIENT"]},
        "note": {"type": "string", "minLength": 1},
        "covered_cores": {
          "type": "array", "uniqueItems": true,
          "items": {"enum": ["CORE2", "CORE2A", "CORE2B"]}
        }
      }
    },
    "learner": {
      "type": "object", "additionalProperties": false,
      "oneOf": [{"required": ["profile_ref"]}, {"required": ["owner_entry"]}, {"required": ["owner_estimate"]}],
      "properties": {
        "profile_ref": {"type": "string", "minLength": 1},
        "owner_entry": {
          "type": "object", "additionalProperties": false, "required": ["rung"],
          "properties": {
            "rung": {"type": "string", "minLength": 1},
            "by": {"type": "string", "minLength": 1},
            "instruction": {"type": "string", "minLength": 1}
          }
        },
        "owner_estimate": {
          "type": "object", "additionalProperties": false, "required": ["knowledge_percentage"],
          "properties": {
            "knowledge_percentage": {"type": "integer", "minimum": 0, "maximum": 100},
            "by": {"type": "string", "minLength": 1},
            "instruction": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "practice": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "CORE2A": {"$ref": "#/$defs/practiceIntent"},
        "CORE2B": {"$ref": "#/$defs/transferIntent"}
      }
    },
    "supplemental_question_policy": {"enum": ["SOURCE_ONLY", "ALLOW_AUTHORED_CANDIDATES"]}
  },
  "$defs": {
    "practiceIntent": {
      "type": "object", "additionalProperties": false, "required": ["purpose"],
      "properties": {"purpose": {"enum": ["STARTER", "PRACTICE", "REVISION", "COMPETITION"]}}
    },
    "transferIntent": {
      "type": "object", "additionalProperties": false, "required": ["purpose"],
      "properties": {"purpose": {"enum": ["PRACTICE", "REVISION", "COMPETITION", "NONE"]}}
    }
  }
}
