{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://grade9v3.local/review-promotion-receipt.schema.json",
  "title":"Review promotion receipt",
  "type":"object",
  "additionalProperties":false,
  "required":[
    "promotion_id","version","subject","target_package","record_id","from_stage","to_stage",
    "record_digest_before","record_digest_after","package_digest_before","package_digest_after",
    "authoring_actor_id","evidence","authoring_run_receipt","prior_promotion_receipt","validation"
  ],
  "properties":{
    "promotion_id":{"type":"string","minLength":1},
    "version":{"const":"1.0.0"},
    "subject":{"type":"string","minLength":1},
    "target_package":{"type":"string","minLength":1},
    "record_id":{"type":"string","minLength":1},
    "from_stage":{"enum":["CANDIDATE","REVIEWED"]},
    "to_stage":{"enum":["REVIEWED","CURATED"]},
    "record_digest_before":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "record_digest_after":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "package_digest_before":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "package_digest_after":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "authoring_actor_id":{"type":"string","minLength":1},
    "evidence":{"type":"object"},
    "authoring_run_receipt":{
      "anyOf":[
        {
          "type":"object","additionalProperties":false,
          "required":["path","digest"],
          "properties":{
            "path":{"type":"string","minLength":1},
            "digest":{"type":"string","pattern":"^[0-9a-f]{64}$"}
          }
        },
        {"type":"null"}
      ]
    },
    "prior_promotion_receipt":{
      "anyOf":[
        {
          "type":"object","additionalProperties":false,
          "required":["path","digest"],
          "properties":{
            "path":{"type":"string","minLength":1},
            "digest":{"type":"string","pattern":"^[0-9a-f]{64}$"}
          }
        },
        {"type":"null"}
      ]
    },
    "validation":{
      "type":"object",
      "additionalProperties":false,
      "required":["state","findings","note"],
      "properties":{
        "state":{"const":"VALIDATED"},
        "findings":{"type":"array","maxItems":0},
        "note":{"type":"string","minLength":1}
      }
    }
  }
}
