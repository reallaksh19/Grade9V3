{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grade9v3.local/source-inspection-receipt.schema.json",
  "title": "Source inspection receipt",
  "description": "Evidence-backed result of inspecting a requested source basis. Coverage is a claim checked against the canonical library; it is not owner-authored routing input.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt_id",
    "version",
    "subject",
    "bucket_id",
    "source_basis",
    "resource_refs",
    "inspection",
    "coverage",
    "notes",
    "basis_assessment"
  ],
  "properties": {
    "receipt_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "bucket_id": {
      "type": "string",
      "minLength": 1
    },
    "source_basis": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "resource_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "inspection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inspector_kind",
        "inspector_id",
        "inspected_at",
        "access_status",
        "sections",
        "content_sha256",
        "snapshot_ref"
      ],
      "properties": {
        "inspector_kind": {
          "enum": [
            "AGENT",
            "HUMAN",
            "LEGACY_METADATA_MIGRATION"
          ]
        },
        "inspector_id": {
          "type": "string",
          "minLength": 1
        },
        "inspected_at": {
          "type": "string",
          "minLength": 1
        },
        "access_status": {
          "enum": [
            "LANDING_INSPECTED",
            "SECTION_INSPECTED",
            "FULL_ITEM_INSPECTED",
            "UNAVAILABLE"
          ]
        },
        "sections": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "content_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "snapshot_ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "CORE2",
        "CORE2A",
        "CORE2B"
      ],
      "properties": {
        "CORE2": {
          "$ref": "#/$defs/coreCoverage"
        },
        "CORE2A": {
          "$ref": "#/$defs/coreCoverage"
        },
        "CORE2B": {
          "$ref": "#/$defs/coreCoverage"
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "basis_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason",
        "replacement_candidates"
      ],
      "properties": {
        "status": {
          "enum": [
            "MATCH",
            "DRIFT",
            "UNKNOWN"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "replacement_candidates": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "coreCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "question_refs",
        "basis"
      ],
      "properties": {
        "status": {
          "enum": [
            "SUFFICIENT",
            "INSUFFICIENT",
            "NOT_EVALUATED"
          ]
        },
        "question_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "basis": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
