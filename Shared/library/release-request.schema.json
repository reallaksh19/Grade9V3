{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grade9v3.local/release-request.schema.json",
  "title": "Learner release request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "release_id",
    "version",
    "subject",
    "request_path",
    "request_digest",
    "packet_digest",
    "publication_path"
  ],
  "properties": {
    "release_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "const": "1.0.0"
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "request_path": {
      "type": "string",
      "minLength": 1
    },
    "request_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "packet_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "publication_path": {
      "type": "string",
      "minLength": 1
    }
  }
}
